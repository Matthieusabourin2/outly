# Outly — environment variables. Template only: never put real values in this file.
# Real env files (.env, .env.local, .env.production…) are git-ignored everywhere.
#
# Local dev: run `pnpm env:local` — it writes apps/*/.env.local from the running local Supabase.
# Hosted: set the PUBLIC values in Cloudflare Pages (build env) and the SERVER values as
# Supabase Edge Function secrets (`supabase secrets set NAME=value`). Never in an app bundle.

# ---------------------------------------------------------------------------
# PUBLIC (bundled into the websites — publishable by design)
# ---------------------------------------------------------------------------
# apps/customer and apps/partner (Expo web)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=        # sb_publishable_… (never the secret / service key)
EXPO_PUBLIC_GOOGLE_SIGN_IN=                  # customer only: "on" to show "Continue with Google"
EXPO_PUBLIC_PRIVACY_EMAIL=                   # customer only: contact shown in the privacy policy
# apps/admin (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SERVER ONLY (Edge Function secrets / Supabase dashboard) — NEVER in an app
# ---------------------------------------------------------------------------
# Provided automatically to Edge Functions by Supabase (used by delete-account):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
# Google sign-in (Supabase Auth provider; also read by supabase/config.toml locally):
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Email sending (Resend SMTP) is configured in the Supabase dashboard → Auth → SMTP, not here.

# Later slices (not used by the code yet):
# GOOGLE_PLACES_API_KEY=                     # slice 2, Places API (New), server key
# EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=           # slice 2, restricted to the iOS bundle id
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=       # slice 2, restricted to the Android package + SHA-1
# STRIPE_SECRET_KEY=                         # membership (8 Nov) — test keys until the CEOs confirm the company
# STRIPE_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=                         # slice 6, AI
