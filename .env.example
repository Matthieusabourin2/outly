# Env files live next to each app (Expo and Next.js only read their own folder):
#   apps/customer/.env.local, apps/partner/.env.local, apps/admin/.env.local
# Copy the matching .env.example there. Local values come from `supabase status`.

# ---- Client-safe (public): publishable key only ----
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=        # slice 2 — restricted to iOS bundle id, Maps SDK only
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=    # slice 2 — restricted to Android package + SHA-1, Maps SDK only
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only: Supabase Edge Function secrets (supabase secrets set ...). NEVER in apps. ----
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=                  # Places API (New), server key
STRIPE_SECRET_KEY=sk_test_              # TEST MODE ONLY (D2) — live keys must never exist
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
QR_HMAC_SECRET=                         # random 32+ bytes
