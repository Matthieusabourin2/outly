# Cloudflare Pages: HTTP headers of the Outly staff site (camera needed to scan passes).
# Keep in sync with apps/partner/vercel.json (same headers if the site is hosted on Vercel). See docs/DEPLOY.md.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  # >>> Content-Security-Policy goes here (owned by the security workstream E, merged by the orchestrator) <<<

# HTML is left to the host default (revalidated on every visit), so a new deploy is picked up at once.
# Built JS and assets have a content hash in their file name: cache them for a year.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Content-Type: application/manifest+json
