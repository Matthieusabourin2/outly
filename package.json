{
  "name": "outly",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:customer": "pnpm --filter @outly/customer start",
    "dev:partner": "pnpm --filter @outly/partner start",
    "dev:admin": "pnpm --filter @outly/admin dev",
    "db:reset": "supabase db reset",
    "db:test": "python3 supabase/tests/run_local.py",
    "db:types": "supabase gen types typescript --local > packages/db/src/types.ts",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "env:local": "node scripts/env-local.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
