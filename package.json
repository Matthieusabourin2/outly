{
  "name": "outly",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:customer": "pnpm --filter @outly/customer start",
    "dev:partner": "pnpm --filter @outly/partner start",
    "dev:admin": "pnpm --filter @outly/admin dev",
    "build:customer-web": "pnpm --filter @outly/customer build:web",
    "build:staff-web": "pnpm --filter @outly/partner build:web",
    "db:reset": "supabase db reset",
    "db:test": "node scripts/db-test.mjs",
    "db:types": "node scripts/db-types.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "env:local": "node scripts/env-local.mjs",
    "db:start": "node scripts/db-start.mjs",
    "db:stop": "supabase stop",
    "db:seed-users": "node scripts/seed-demo-users.mjs",
    "rouge:setup": "node scripts/rouge/setup-night.mjs",
    "rouge:staff": "node scripts/rouge/staff.mjs",
    "check:secrets": "node scripts/check-bundle-secrets.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "supabase": "2.119.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
